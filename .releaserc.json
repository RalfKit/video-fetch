{
	"branches": ["main"],
	"plugins": [
		[
			"@semantic-release/commit-analyzer",
			{
				"releaseRules": [{ "type": "build", "scope": "deps", "release": "patch" }]
			}
		],
		"@semantic-release/release-notes-generator",
		"@semantic-release/changelog",
		["@semantic-release/npm", { "npmPublish": false }],
		[
			"@semantic-release/exec",
			{
				"prepareCmd": "docker buildx build --push --label org.opencontainers.image.version=${nextRelease.version} --label org.opencontainers.image.source=https://github.com/$GITHUB_REPOSITORY -t $DOCKERHUB_USERNAME/videofetch:${nextRelease.version} -t $DOCKERHUB_USERNAME/videofetch:latest ."
			}
		],
		[
			"@semantic-release/git",
			{
				"assets": ["CHANGELOG.md", "package.json"],
				"message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
			}
		],
		"@semantic-release/github"
	]
}
