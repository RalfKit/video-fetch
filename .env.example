PUBLIC_DEFAULT_CONCURRENCY=1
PUBLIC_MAX_CONCURRENCY=5
DOWNLOAD_PATH="/downloads"
TEMP_DOWNLOAD_PATH="/downloads/.incomplete"
DATABASE_PATH="/data/downloads.db"
CONCURRENCY_WINDOWS="01:00-05:00=5"

# Optional: also delete the downloaded file when a completed download is removed.
# Default is false (only the database entry is deleted; the file is kept).
DELETE_FILE_ON_DELETE=false

# Optional: enable thumbnails. Default is true. When set to false, no thumbnail
# URLs are stored and yt-dlp does not download thumbnail files.
ENABLE_THUMBNAILS=true

# Optional: explicit paths to the yt-dlp / ffmpeg binaries. When unset, known
# locations (/usr/local/bin, /usr/bin) are used if present, otherwise the
# yt-dlp binary bundled with ytdlp-nodejs and ffmpeg from PATH are used.
# YTDLP_PATH="/usr/local/bin/yt-dlp"
# FFMPEG_PATH="/usr/local/bin/ffmpeg"
